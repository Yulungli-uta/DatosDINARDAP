<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <!-- WsUtaDinardap.Api reemplaza el consumo SOAP directo de abajo (ver Datos/Infrastructure).
         ClientSecret NUNCA va aqui: se lee de la variable de entorno WSUTADINARDAP_CLIENT_SECRET.
         El bloque system.serviceModel se deja tal cual (ya no se usa) solo porque el proxy WCF
         generado (Service References/ServiceReferenceDINARDAP) sigue compilando en el proyecto;
         no es necesario para el flujo actual. -->
    <appSettings>
        <add key="WsUtaDinardapApi.BaseUrl" value="https://localhost:5001" />
        <add key="WsUtaDinardapApi.AuthServiceUrl" value="http://localhost:5010" />
        <add key="WsUtaDinardapApi.ClientId" value="datosdinardap-legacy" />
        <add key="WsUtaDinardapApi.TimeoutSeconds" value="30" />
    </appSettings>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
              <binding name="InteroperadorlImplServiceSoapBinding">
                <security mode="Transport">
                  <transport clientCredentialType="Basic" proxyCredentialType="Basic" realm="">
                    <extendedProtectionPolicy policyEnforcement="Never"/>
                  </transport>
                </security>
              </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://interoperabilidad.dinardap.gob.ec:7979/interoperador" binding="basicHttpBinding" bindingConfiguration="InteroperadorlImplServiceSoapBinding" contract="ServiceReferenceDINARDAP.IInteroperador" name="InteroperadorlImplPort"/>
        </client>
    </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
